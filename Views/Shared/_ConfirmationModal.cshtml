<div class="modal fade" id="confirmation-modal" tabindex="-1" aria-labelledby="confirmation-modal-title" aria-describedby="confirmation-modal-message" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirmation-modal">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="confirmation-modal-title">Xác nhận thao tác</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p id="confirmation-modal-message" class="mb-0">Bạn có chắc chắn muốn tiếp tục?</p>
