@model MilkTeaWeb.ViewModels.Products.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var firstImage = Model.Images.FirstOrDefault();
}

<div class="product-detail-back">
    <a asp-action="Index">← Quay lại menu</a>
</div>

<section class="product-detail" data-shop-product>
    <div class="product-gallery">
        <div class="product-gallery__main" aria-live="polite">
            @if (firstImage is null)
            {
                <span class="product-placeholder product-placeholder--large" role="img" aria-label="Chưa có ảnh sản phẩm">☕</span>
            }
            else
            {
                <img data-gallery-main src="@firstImage.ImagePath" alt="@Model.Name" />
            }
        </div>
        @if (Model.Images.Count > 1)
        {
            <div class="product-gallery__thumbs" aria-label="Ảnh sản phẩm">
                @for (var imageIndex = 0; imageIndex < Model.Images.Count; imageIndex++)
                {
                    var image = Model.Images[imageIndex];
                    <button class="product-gallery__thumb @(imageIndex == 0 ? "is-active" : null)" type="button" data-gallery-image="@image.ImagePath" aria-label="Xem ảnh @(imageIndex + 1) của @Model.Name" aria-current="@(imageIndex == 0 ? "true" : "false")">
                        <img src="@image.ImagePath" alt="" />
                    </button>
                }
            </div>
        }
    </div>

    <div class="product-detail__info">
        <p class="eyebrow">@Model.CategoryName</p>
        <h1>@Model.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="product-detail__description">@Model.Description</p>
        }
        <p class="product-detail__starting-price">Từ @Model.StartingPrice.ToString("N0") đ</p>

        <form asp-controller="Cart" asp-action="Add" method="post" class="product-configurator" data-shop-configurator>
            @if (Model.IsEditing)
            {
                <input asp-for="Input.CartItemId" type="hidden" />
                <input asp-for="Input.GuestLineKey" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert" tabindex="-1"></div>
            <fieldset class="product-option-group">
                <legend>Kích cỡ</legend>
                <div class="product-option-grid product-option-grid--sizes">
                    @foreach (var size in Model.Sizes)
                    {
                        <label class="product-choice">
                            <input asp-for="Input.ProductSizeId" id="size-@size.ProductSizeId" type="radio" value="@size.ProductSizeId" data-size-price="@size.Price" />
                            <span><strong>@size.Name</strong><small>@size.Price.ToString("N0") đ</small></span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Input.ProductSizeId" class="field-validation-error"></span>
            </fieldset>

            @if (Model.SugarLevels.Count > 0)
            {
                <fieldset class="product-option-group">
                    <legend>Mức đường</legend>
                    <div class="product-option-grid product-option-grid--pills">
                        @foreach (var level in Model.SugarLevels)
                        {
                            <label class="product-pill"><input asp-for="Input.SugarLevelId" id="sugar-@level.LevelId" type="radio" value="@level.LevelId" /><span>@level.Percentage%</span></label>
                        }
                    </div>
                </fieldset>
            }

            @if (Model.IceLevels.Count > 0)
            {
                <fieldset class="product-option-group">
                    <legend>Mức đá</legend>
                    <div class="product-option-grid product-option-grid--pills">
                        @foreach (var level in Model.IceLevels)
                        {
                            <label class="product-pill"><input asp-for="Input.IceLevelId" id="ice-@level.LevelId" type="radio" value="@level.LevelId" /><span>@level.Percentage%</span></label>
                        }
                    </div>
                </fieldset>
            }

            @if (Model.Toppings.Count > 0)
            {
                <fieldset class="product-option-group">
                    <legend>Topping</legend>
                    <div class="product-option-grid">
                        @foreach (var topping in Model.Toppings)
                        {
                            <label class="product-choice product-choice--topping">
                                <input name="Input.ToppingIds" type="checkbox" value="@topping.ToppingId" data-topping-price="@topping.Price" @(Model.Input.ToppingIds.Contains(topping.ToppingId) ? "checked" : null) />
                                <span><strong>@topping.Name</strong><small>+@topping.Price.ToString("N0") đ</small></span>
                            </label>
                        }
                    </div>
                </fieldset>
            }

            <div class="product-configurator__footer">
                <div class="quantity-control" data-quantity-control>
                    <label asp-for="Input.Quantity">Số lượng</label>
                    <div>
                        <button type="button" data-quantity-step="-1" aria-label="Giảm số lượng">−</button>
                        <input asp-for="Input.Quantity" min="1" inputmode="numeric" />
                        <button type="button" data-quantity-step="1" aria-label="Tăng số lượng">+</button>
                    </div>
                    <span asp-validation-for="Input.Quantity" class="field-validation-error"></span>
                </div>
                <div class="product-configurator__total">
                    <span>Tạm tính</span>
                    <strong data-price-preview aria-live="polite">@Model.StartingPrice.ToString("N0") đ</strong>
                </div>
                <button class="btn btn-primary product-configurator__submit" type="submit" data-submit-loading>@(Model.IsEditing ? "Lưu thay đổi" : "Thêm vào giỏ hàng")</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/shop.js" asp-append-version="true"></script>
}
