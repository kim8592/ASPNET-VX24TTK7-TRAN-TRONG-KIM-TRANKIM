@{
    ViewData["Title"] = "Kiểm tra email";
}

<section class="account-shell account-shell--security">
    <div class="account-card account-card--security">
        <div class="account-card__header">
            <p class="eyebrow">Khôi phục tài khoản</p>
            <h1>Kiểm tra email</h1>
            <p>Nếu tài khoản phù hợp, hướng dẫn đặt lại mật khẩu đã được gửi.</p>
        </div>
        <div class="account-result account-result--success" role="status"><span class="account-result__icon" aria-hidden="true">✓</span><p>Hãy kiểm tra cả thư mục spam hoặc quảng cáo nếu bạn chưa thấy email.</p></div>
        <div class="account-links account-links--result"><a class="account-link--primary" asp-action="Login">Quay lại Đăng nhập</a></div>
    </div>
</section>
