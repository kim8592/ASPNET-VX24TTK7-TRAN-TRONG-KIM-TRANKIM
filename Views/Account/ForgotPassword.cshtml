@model ForgotPasswordInputModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="account-shell account-shell--security">
    <div class="account-card account-card--security">
        <div class="account-card__header">
            <p class="eyebrow">Khôi phục tài khoản</p>
            <h1>Quên mật khẩu</h1>
            <p>Nếu tài khoản phù hợp, hướng dẫn đặt lại mật khẩu sẽ được gửi đến email của bạn.</p>
        </div>
        <form asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-valid" role="alert" tabindex="-1"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label is-required">Email</label>
                <input asp-for="Email" class="form-control" autocomplete="email" aria-describedby="ForgotPassword_Email-error" />
                <span asp-validation-for="Email" class="field-validation-error" id="ForgotPassword_Email-error"></span>
            </div>
            <div class="account-form-actions"><button class="btn btn-primary" type="submit">Gửi hướng dẫn</button></div>
        </form>
        <div class="account-links"><a asp-action="Login">Quay lại Đăng nhập</a></div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
