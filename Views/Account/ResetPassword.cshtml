@model ResetPasswordInputModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="account-shell account-shell--security">
    <div class="account-card account-card--security">
        <div class="account-card__header">
            <p class="eyebrow">Khôi phục tài khoản</p>
            <h1>Đặt lại mật khẩu</h1>
            <p>Chọn mật khẩu mới cho tài khoản của bạn.</p>
        </div>
        <form asp-action="ResetPassword" method="post" novalidate>
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-valid" role="alert" tabindex="-1"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label is-required">Mật khẩu mới</label>
                <div class="input-group">
                    <input asp-for="NewPassword" class="form-control" id="reset-password" autocomplete="new-password" aria-describedby="ResetPassword_NewPassword-hint ResetPassword_NewPassword-error" />
                    <button class="btn btn-secondary password-toggle" type="button" data-password-toggle="reset-password" aria-pressed="false">Hiện</button>
                </div>
                <p id="ResetPassword_NewPassword-hint" class="account-password-hint">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                <span asp-validation-for="NewPassword" class="field-validation-error" id="ResetPassword_NewPassword-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label is-required">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-describedby="ResetPassword_ConfirmPassword-error" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error" id="ResetPassword_ConfirmPassword-error"></span>
            </div>
            <div class="account-form-actions"><button class="btn btn-primary" type="submit">Đặt lại mật khẩu</button></div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
