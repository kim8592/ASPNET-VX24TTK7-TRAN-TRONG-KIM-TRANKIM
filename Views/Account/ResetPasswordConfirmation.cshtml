@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<section class="account-shell account-shell--security">
    <div class="account-card account-card--security">
        <div class="account-card__header">
            <p class="eyebrow">Khôi phục tài khoản</p>
            <h1>Đặt lại mật khẩu thành công</h1>
            <p>Bạn có thể đăng nhập bằng mật khẩu mới.</p>
        </div>
        <div class="account-result account-result--success" role="status"><span class="account-result__icon" aria-hidden="true">✓</span><p>Mật khẩu mới đã được cập nhật. Bạn có thể đăng nhập ngay.</p></div>
        <div class="account-links account-links--result"><a class="account-link--primary" asp-action="Login">Đi tới Đăng nhập</a></div>
    </div>
</section>
