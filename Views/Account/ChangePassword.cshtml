@model ChangePasswordInputModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<section class="account-shell account-shell--security">
    <div class="account-card account-card--security">
        <div class="account-card__header">
            <p class="eyebrow">Bảo mật</p>
            <h1>Đổi mật khẩu</h1>
            <p>Xác minh mật khẩu hiện tại trước khi đặt mật khẩu mới.</p>
        </div>
        <form asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-valid" role="alert" tabindex="-1"></div>
            <p class="account-form-note">Mật khẩu mới sẽ áp dụng cho các lần đăng nhập sau.</p>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label is-required">Mật khẩu hiện tại</label>
                <div class="input-group"><input asp-for="CurrentPassword" class="form-control" id="change-current-password" autocomplete="current-password" aria-describedby="ChangePassword_CurrentPassword-error" /><button class="btn btn-secondary password-toggle" type="button" data-password-toggle="change-current-password" aria-pressed="false">Hiện</button></div>
                <span asp-validation-for="CurrentPassword" class="field-validation-error" id="ChangePassword_CurrentPassword-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label is-required">Mật khẩu mới</label>
                <div class="input-group"><input asp-for="NewPassword" class="form-control" id="change-new-password" autocomplete="new-password" aria-describedby="ChangePassword_NewPassword-hint ChangePassword_NewPassword-error" /><button class="btn btn-secondary password-toggle" type="button" data-password-toggle="change-new-password" aria-pressed="false">Hiện</button></div>
                <p id="ChangePassword_NewPassword-hint" class="account-password-hint">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p>
                <span asp-validation-for="NewPassword" class="field-validation-error" id="ChangePassword_NewPassword-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label is-required">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-describedby="ChangePassword_ConfirmPassword-error" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error" id="ChangePassword_ConfirmPassword-error"></span>
            </div>
            <div class="account-form-actions"><button class="btn btn-primary" type="submit">Lưu mật khẩu mới</button></div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
