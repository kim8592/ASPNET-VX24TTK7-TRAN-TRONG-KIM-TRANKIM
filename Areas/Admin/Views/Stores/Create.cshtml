@model StoreInputModel
@{
    ViewData["Title"] = "Thêm cửa hàng";
}

<section class="account-shell" aria-labelledby="store-create-title"><div class="account-card"><div class="account-card__header"><p class="eyebrow">Cửa hàng</p><h1 id="store-create-title">Thêm cửa hàng</h1></div><form method="post" novalidate><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="mb-3"><label asp-for="Name" class="form-label is-required">Tên cửa hàng</label><input asp-for="Name" class="form-control" autocomplete="off" /><span asp-validation-for="Name" class="field-validation-error"></span></div><div class="mb-3"><label asp-for="Address" class="form-label is-required">Địa chỉ</label><textarea asp-for="Address" class="form-control"></textarea><span asp-validation-for="Address" class="field-validation-error"></span></div><div class="mb-4"><label asp-for="Phone" class="form-label is-required">Số điện thoại</label><input asp-for="Phone" class="form-control" type="tel" autocomplete="tel" /><span asp-validation-for="Phone" class="field-validation-error"></span></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu cửa hàng</button><a class="btn btn-secondary" asp-action="Index">Quay lại</a></div></form></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
