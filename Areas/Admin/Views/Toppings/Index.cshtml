@using System.Globalization
@model IReadOnlyList<ToppingListItemViewModel>
@{
    ViewData["Title"] = "Topping";
}

<section class="admin-resource-page" aria-labelledby="toppings-title"><div class="admin-page-heading"><div><p class="eyebrow">Catalog</p><h1 id="toppings-title">Topping</h1><p class="mb-0 text-muted">Quản lý các lựa chọn thêm và giá cộng vào món.</p></div><a class="btn btn-primary" asp-action="Create">Thêm topping</a></div><div class="admin-resource-overview" aria-label="Tổng quan topping"><div><span>Tổng topping</span><strong>@Model.Count</strong></div><div class="admin-resource-overview__positive"><span>Đang hoạt động</span><strong>@Model.Count(item => item.IsActive)</strong></div></div>@if (Model.Count == 0){<div class="empty-state">Chưa có topping nào.</div>}else{<div class="table-responsive admin-resource-table-wrap"><table class="table align-middle admin-resource-table"><thead><tr><th scope="col">Tên</th><th scope="col">Giá</th><th scope="col">Trạng thái</th><th scope="col" class="text-end">Thao tác</th></tr></thead><tbody>@foreach (var item in Model){<tr><td data-label="Tên"><strong>@item.Name</strong></td><td data-label="Giá"><strong class="admin-resource-price">@item.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</strong></td><td data-label="Trạng thái"><span class="status-badge @(item.IsActive ? "alert-success" : "alert-warning")">@(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></td><td data-label="Thao tác"><div class="admin-resource-actions"><a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.ToppingId">Sửa</a>@if (item.IsActive){<form asp-action="SetActive" asp-route-id="@item.ToppingId" method="post" data-confirm-form data-confirm-title="Ngừng hoạt động topping" data-confirm-message="Topping này sẽ không còn được chọn cho cấu hình sản phẩm mới." data-confirm-button-label="Ngừng hoạt động" data-confirm-button-style="btn-warning"><button class="btn btn-sm btn-caution" type="submit">Ngừng hoạt động</button></form>}else{<form asp-action="SetActive" asp-route-id="@item.ToppingId" method="post"><button class="btn btn-sm btn-primary" type="submit">Kích hoạt</button></form>}</div></td></tr>}</tbody></table></div>}</section>
