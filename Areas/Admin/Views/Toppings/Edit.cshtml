@model ToppingInputModel
@{
    ViewData["Title"] = "Sửa topping";
}

<section class="account-shell" aria-labelledby="topping-edit-title"><div class="account-card"><div class="account-card__header"><p class="eyebrow">Topping</p><h1 id="topping-edit-title">Sửa topping</h1></div><form method="post" novalidate><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="mb-3"><label asp-for="Name" class="form-label is-required">Tên topping</label><input asp-for="Name" class="form-control" autocomplete="off" /><span asp-validation-for="Name" class="field-validation-error"></span></div><div class="mb-4"><label asp-for="Price" class="form-label is-required">Giá (₫)</label><input asp-for="Price" class="form-control" min="0" step="0.01" /><span asp-validation-for="Price" class="field-validation-error"></span></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu thay đổi</button><a class="btn btn-secondary" asp-action="Index">Quay lại</a></div></form></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
