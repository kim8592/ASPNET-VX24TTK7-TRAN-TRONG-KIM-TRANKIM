@model SizeInputModel
@{
    ViewData["Title"] = "Thêm kích cỡ";
}

<section class="account-shell" aria-labelledby="size-create-title"><div class="account-card"><div class="account-card__header"><p class="eyebrow">Kích cỡ</p><h1 id="size-create-title">Thêm kích cỡ</h1></div><form method="post" novalidate><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="mb-3"><label asp-for="Name" class="form-label is-required">Tên kích cỡ</label><input asp-for="Name" class="form-control" autocomplete="off" /><span asp-validation-for="Name" class="field-validation-error"></span></div><div class="mb-4"><label asp-for="DisplayOrder" class="form-label is-required">Thứ tự hiển thị</label><input asp-for="DisplayOrder" class="form-control" min="0" /><span asp-validation-for="DisplayOrder" class="field-validation-error"></span></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu kích cỡ</button><a class="btn btn-secondary" asp-action="Index">Quay lại</a></div></form></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
