@model IReadOnlyList<SizeListItemViewModel>
@{
    ViewData["Title"] = "Kích cỡ";
}

<section class="admin-resource-page" aria-labelledby="sizes-title"><div class="admin-page-heading"><div><p class="eyebrow">Catalog</p><h1 id="sizes-title">Kích cỡ</h1><p class="mb-0 text-muted">Các mức kích cỡ dùng khi cấu hình giá bán cho từng sản phẩm.</p></div><a class="btn btn-primary" asp-action="Create">Thêm kích cỡ</a></div><div class="admin-resource-overview" aria-label="Tổng quan kích cỡ"><div><span>Tổng kích cỡ</span><strong>@Model.Count</strong></div></div>@if (Model.Count == 0){<div class="empty-state">Chưa có kích cỡ nào.</div>}else{<div class="table-responsive admin-resource-table-wrap"><table class="table align-middle admin-resource-table"><thead><tr><th scope="col">Tên</th><th scope="col">Thứ tự hiển thị</th><th scope="col" class="text-end">Thao tác</th></tr></thead><tbody>@foreach (var item in Model){<tr><td data-label="Tên"><strong>@item.Name</strong></td><td data-label="Thứ tự hiển thị"><span class="admin-order-index">@item.DisplayOrder</span></td><td data-label="Thao tác" class="text-end"><div class="admin-resource-actions"><a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.SizeId">Sửa</a></div></td></tr>}</tbody></table></div>}</section>
