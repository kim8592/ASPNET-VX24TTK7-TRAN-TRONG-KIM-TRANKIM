@model CategoryInputModel
@{
    ViewData["Title"] = "Thêm danh mục";
}

<section class="account-shell" aria-labelledby="category-create-title"><div class="account-card"><div class="account-card__header"><p class="eyebrow">Danh mục</p><h1 id="category-create-title">Thêm danh mục</h1></div><form method="post" novalidate><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="mb-3"><label asp-for="Name" class="form-label is-required">Tên danh mục</label><input asp-for="Name" class="form-control" autocomplete="off" /><span asp-validation-for="Name" class="field-validation-error"></span></div><div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu danh mục</button><a class="btn btn-secondary" asp-action="Index">Quay lại</a></div></form></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
