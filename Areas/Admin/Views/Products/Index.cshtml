@model IReadOnlyList<AdminProductListItemViewModel>
@{
    ViewData["Title"] = "Sản phẩm";
}

<section class="admin-products-page" aria-labelledby="products-title">
    <div class="admin-page-heading">
        <div>
            <p class="eyebrow">Catalog</p>
            <h1 id="products-title">Sản phẩm</h1>
            <p class="mb-0 text-muted">Quản lý món trên menu, khả dụng và cấu hình hiển thị.</p>
        </div>
        <a class="btn btn-primary" asp-action="Create">Thêm sản phẩm</a>
    </div>

    <div class="admin-product-overview" aria-label="Tổng quan sản phẩm">
        <div>
            <span>Tổng sản phẩm</span>
            <strong>@Model.Count</strong>
        </div>
        <div class="admin-product-overview__positive">
            <span>Có thể bán</span>
            <strong>@Model.Count(item => item.IsSellable)</strong>
        </div>
        <div class="admin-product-overview__muted">
            <span>Ngừng bán</span>
            <strong>@Model.Count(item => !item.IsAvailable)</strong>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">Chưa có sản phẩm nào. Hãy tạo sản phẩm cơ bản đầu tiên.</div>
    }
    else
    {
        <div class="table-responsive admin-products-table-wrap">
            <table class="table align-middle admin-products-table">
                <thead><tr><th scope="col">Sản phẩm</th><th scope="col">Danh mục</th><th scope="col">Khả dụng</th><th scope="col">Có thể bán</th><th scope="col" class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td data-label="Sản phẩm"><div class="admin-product-name">@if (!string.IsNullOrWhiteSpace(item.ImagePath)) { <img class="admin-product-thumbnail" src="@item.ImagePath" alt="@item.Name" loading="lazy" /> } else { <span class="admin-product-thumbnail admin-product-thumbnail--empty" aria-hidden="true">—</span> }<strong>@item.Name</strong></div></td>
                        <td data-label="Danh mục">@item.CategoryName</td>
                        <td data-label="Khả dụng"><span class="status-badge @(item.IsAvailable ? "alert-success" : "alert-warning")">@(item.IsAvailable ? "Đang bán" : "Ngừng bán")</span></td>
                        <td data-label="Có thể bán"><span class="status-badge @(item.IsSellable ? "alert-success" : "alert-warning")">@(item.IsSellable ? "Có thể bán" : "Chưa thể bán")</span>@if (!item.IsSellable) { <div class="small text-muted mt-1">@item.SellabilityReason</div> }</td>
                        <td class="text-end" data-label="Thao tác"><div class="admin-product-actions"><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.ProductId">Sửa</a><a class="btn btn-sm btn-secondary" asp-action="Configuration" asp-route-id="@item.ProductId">Cấu hình</a><a class="btn btn-sm btn-secondary" asp-action="Images" asp-route-id="@item.ProductId">Ảnh</a></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
