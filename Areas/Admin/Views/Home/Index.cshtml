@{
    ViewData["Title"] = "Tổng quan";
}

<section class="admin-dashboard" aria-labelledby="admin-home-title">
    <div class="admin-dashboard__heading">
        <div>
            <p class="eyebrow">Quản trị</p>
            <h1 id="admin-home-title">Quản lý danh mục</h1>
            <p class="text-muted">Chọn một khu vực để quản lý dữ liệu catalog hiện có.</p>
        </div>
        <div class="admin-dashboard__hint" role="note"><strong>Gợi ý thao tác</strong><span>Cập nhật sản phẩm trước, sau đó kiểm tra cấu hình và ảnh hiển thị.</span></div>
    </div>

    <h2 class="visually-hidden">Các khu vực quản lý</h2>
    <div class="row g-4 mt-2 admin-catalog-grid">
        <div class="col-md-6 col-xl-4">
            <a class="admin-catalog-card" asp-controller="Categories" asp-action="Index">
                <span class="admin-catalog-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 5h16v14H4zM4 9h16M8 5v14" /></svg>
                </span>
                <span class="admin-catalog-card__body"><strong>Danh mục</strong><span>Tổ chức nhóm sản phẩm</span></span>
                <span class="admin-catalog-card__arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="admin-catalog-card" asp-controller="Products" asp-action="Index">
                <span class="admin-catalog-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M6 9h12l-1 10H7L6 9ZM8 9a4 4 0 0 1 8 0M9 13h.01M15 13h.01" /></svg>
                </span>
                <span class="admin-catalog-card__body"><strong>Sản phẩm</strong><span>Quản lý thông tin và trạng thái bán</span></span>
                <span class="admin-catalog-card__arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="admin-catalog-card" asp-controller="Sizes" asp-action="Index">
                <span class="admin-catalog-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="m4 16 12-12 4 4L8 20H4v-4ZM13 7l4 4M8 16h.01M11 13h.01M14 10h.01" /></svg>
                </span>
                <span class="admin-catalog-card__body"><strong>Kích cỡ</strong><span>Thiết lập danh sách kích cỡ</span></span>
                <span class="admin-catalog-card__arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="admin-catalog-card" asp-controller="Toppings" asp-action="Index">
                <span class="admin-catalog-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><circle cx="8" cy="8" r="2.5" /><circle cx="16" cy="8" r="2.5" /><circle cx="8" cy="16" r="2.5" /><circle cx="16" cy="16" r="2.5" /></svg>
                </span>
                <span class="admin-catalog-card__body"><strong>Topping</strong><span>Quản lý lựa chọn thêm</span></span>
                <span class="admin-catalog-card__arrow" aria-hidden="true">→</span>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="admin-catalog-card" asp-controller="Stores" asp-action="Index">
                <span class="admin-catalog-card__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false"><path d="M4 10h16v10H4zM6 10l1-5h10l1 5M8 14h3v6H8zM15 14h3M15 17h3" /></svg>
                </span>
                <span class="admin-catalog-card__body"><strong>Cửa hàng</strong><span>Quản lý địa điểm phục vụ</span></span>
                <span class="admin-catalog-card__arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>
